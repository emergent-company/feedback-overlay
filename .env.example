# GitHub OAuth app credentials (required for sign-in). A GitHub App or OAuth
# App both work: client id/secret + callback URL.
GH_APP_CLIENT_ID=your_client_id_here
GH_APP_CLIENT_SECRET=your_client_secret_here
GH_REDIRECT_URI=https://feedback.emergent-company.ai/auth/callback

# Optional GitHub App bot (issue authoring). Required only for ISSUE_AUTHOR_MODE=bot
# when you are not using GH_BOT_TOKEN. Get the installation ID at:
# https://github.com/organizations/<org>/settings/installations
# GH_APP_ID=your_app_id_here
# GH_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# GH_APP_PRIVATE_KEY_PATH=/run/secrets/gh-app.pem
# GH_INSTALLATION_ID=your_installation_id_here

# Issue author mode: "bot" (default) uses a GitHub App or GH_BOT_TOKEN;
# "user" authors issues with each reporter's own GitHub token.
ISSUE_AUTHOR_MODE=bot

# Optional: fine-grained PAT used to create issues when no GitHub App is configured.
# This lets self-hosters skip App creation entirely (login still uses the OAuth client above).
GH_BOT_TOKEN=

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_32_byte_hex_string

# Server config
PORT=8080
DB_PATH=/data/feedback-overlay.db

# Optional: enables the MCP endpoint at /mcp. Agents authenticate with
# "Authorization: Bearer <MCP_API_KEY>". Leave empty to disable MCP.
MCP_API_KEY=

# Comma-separated allowed CORS origins (use * to allow all)
ALLOWED_ORIGINS=*

# IP of your internal reverse proxy (e.g. Traefik) — used in extra_hosts so
# the container can resolve your public domain internally. Remove or leave
# blank if you use external DNS resolution instead.
TRAEFIK_HOST=
